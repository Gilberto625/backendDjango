# Django Settings
SECRET_KEY=tu-secret-key-aqui
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Render lo provee automáticamente como DATABASE_URL)
# DATABASE_URL=postgresql://user:password@host:5432/database

# Email Configuration (Gmail)
EMAIL_HOST_USER=tu-email@gmail.com
EMAIL_HOST_PASSWORD=tu-app-password-aqui

# CORS Settings (URLs del frontend Angular)
# En producción agregar: https://tu-frontend.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# CSRF Trusted Origins
# En producción agregar: https://tu-backend.onrender.com,https://tu-frontend.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
